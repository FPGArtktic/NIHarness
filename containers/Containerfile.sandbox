#
# The tool sandbox: everything the gate drives, and nothing that can reach a
# network. Build this on a machine with network, then `podman save` / `podman
# load` it onto the air-gapped host. The harness never pulls an image.
#
#   podman build -t localhost/niharness-sandbox:latest -f containers/Containerfile.sandbox .
#
# Layers are ordered coldest first, so adding a language does not rebuild the base.

FROM docker.io/library/debian:trixie-slim AS base

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PIP_NO_INDEX=1 \
    CARGO_NET_OFFLINE=true

RUN apt-get update && apt-get install --no-install-recommends -y \
      ca-certificates git make pkg-config file jq ripgrep \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------- C / C++
FROM base AS cxx
RUN apt-get update && apt-get install --no-install-recommends -y \
      build-essential cmake ninja-build ccache \
      clang clang-format clang-tidy cppcheck gdb valgrind \
      clangd \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------- scripting
FROM cxx AS scripting
RUN apt-get update && apt-get install --no-install-recommends -y \
      python3 python3-venv shellcheck shfmt bats tcl tcllib \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------- HDL
FROM scripting AS hdl
RUN apt-get update && apt-get install --no-install-recommends -y \
      verilator ghdl iverilog \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------- language servers
#
# `find_symbol`, `find_references` and `file_outline` ask a language server,
# which is why the servers belong in the image rather than on the host: a
# sandboxed run cannot see the host's. Which server serves which language is
# the table in `niharness.domain.language_servers`; the names below are the
# first candidate of each.
#
# This is the layer that costs disk - clangd alone is a few hundred megabytes.
# A project that does not want it can drop this stage and set
# `[lsp] enabled = false`, and the symbol tools will say so instead of failing.
# `clangd` comes from the cxx stage and Python's from the wheelhouse below, so
# both are pinned with everything else. Bash's is not packaged by Debian at
# all - `bash-language-server` is npm - and this stage installs it from there.
# That reaches the network at *build* time, which is a connected machine by
# definition: the rule is that nothing is fetched at **run** time, and the
# image is sealed by the time it is exported. A language whose server is
# neither packaged nor installed here simply has none, and the symbol tools say
# so rather than failing - `nih tools` prints which are present.
FROM hdl AS lsp
RUN apt-get update && apt-get install --no-install-recommends -y \
      nodejs npm \
    && npm install --global --no-fund --no-audit bash-language-server \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* /root/.npm

# ------------------------------------------------------------- the tool server
FROM lsp AS final

# The server is this project's own package, installed from a local wheelhouse so
# the build needs no index - and beside it the Python tools the **gate** runs,
# because the gate runs in here. An image carrying only the runtime builds
# fine and then cannot lint a line of Python, which is what a first build of
# this file produced.
#
# Prepare the context on a networked machine first:
#
#   uv build --wheel --out-dir wheelhouse
#   uv export --frozen --no-dev --no-emit-project -o wheelhouse/requirements.lock
#   uv tool run --from pip pip download -r wheelhouse/requirements.lock \
#       -d wheelhouse --only-binary=:all:
#   uv tool run --from pip pip download ruff mypy pytest basedpyright \
#       -d wheelhouse --only-binary=:all:
#
# then build the image, save it, and load it on the air-gapped host.
#
# `--no-dev` matters: the full lock carries this project's own test and docs
# tooling, some of which has no wheel for this interpreter, and none of which
# the sandbox needs. What the sandbox needs is the gate's matrix, which is a
# different list and is named explicitly above.
COPY wheelhouse/ /tmp/wheelhouse/
RUN python3 -m venv /opt/nih \
    && /opt/nih/bin/pip install --no-index --find-links=/tmp/wheelhouse \
         niharness ruff mypy pytest basedpyright \
    && rm -rf /tmp/wheelhouse /root/.cache
ENV PATH=/opt/nih/bin:$PATH

# `basedpyright-langserver` lands on PATH from that same install, so the Python
# symbol tools are pinned with everything else rather than pulled at build
# time.

# The sandbox runs as a non-root user with the worktree bind-mounted at /work.
RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin agent
WORKDIR /work
USER agent

# No ENTRYPOINT on purpose: the harness passes a fixed argument vector, never a
# shell string, and `shell` is in no default tool allowlist. The tool server is
# started explicitly:
#
#   podman run -i --network=none --volume <worktree>:/work:rw,Z ... \
#       localhost/niharness-sandbox:latest \
#       python -m niharness.toolserver --root /work
CMD ["/bin/false"]
