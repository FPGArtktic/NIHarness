#
# The tool sandbox: everything the gate drives, and nothing that can reach a
# network. Build this on a machine with network, then `podman save` / `podman
# load` it onto the air-gapped host. The harness never pulls an image.
#
#   podman build -t localhost/niharness-sandbox:latest -f containers/Containerfile.sandbox .
#
# Layers are ordered coldest first, so adding a language does not rebuild the base.

FROM docker.io/library/debian:trixie-slim AS base

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PIP_NO_INDEX=1 \
    CARGO_NET_OFFLINE=true

RUN apt-get update && apt-get install --no-install-recommends -y \
      ca-certificates git make pkg-config file jq ripgrep \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------- C / C++
FROM base AS cxx
RUN apt-get update && apt-get install --no-install-recommends -y \
      build-essential cmake ninja-build ccache \
      clang clang-format clang-tidy cppcheck gdb valgrind \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------- scripting
FROM cxx AS scripting
RUN apt-get update && apt-get install --no-install-recommends -y \
      python3 python3-venv shellcheck shfmt bats tcl tcllib \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------- HDL
FROM scripting AS hdl
RUN apt-get update && apt-get install --no-install-recommends -y \
      verilator ghdl iverilog \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------- the tool server
FROM hdl AS final

# The server is this project's own package, installed from a local wheelhouse so
# the build needs no index. Prepare the context on a networked machine first:
#
#   uv build --wheel --out-dir wheelhouse
#   uv export --frozen --no-emit-project -o requirements.lock
#   uv pip download -r requirements.lock -d wheelhouse
#
# then build the image, save it, and load it on the air-gapped host.
COPY wheelhouse/ /tmp/wheelhouse/
RUN python3 -m venv /opt/nih \
    && /opt/nih/bin/pip install --no-index --find-links=/tmp/wheelhouse niharness \
    && rm -rf /tmp/wheelhouse /root/.cache
ENV PATH=/opt/nih/bin:$PATH

# The sandbox runs as a non-root user with the worktree bind-mounted at /work.
RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin agent
WORKDIR /work
USER agent

# No ENTRYPOINT on purpose: the harness passes a fixed argument vector, never a
# shell string, and `shell` is in no default tool allowlist. The tool server is
# started explicitly:
#
#   podman run -i --network=none --volume <worktree>:/work:rw,Z ... \
#       localhost/niharness-sandbox:latest \
#       python -m niharness.toolserver --root /work
CMD ["/bin/false"]
