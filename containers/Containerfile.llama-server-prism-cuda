#
# llama-server from the PrismML fork, with the CUDA kernels.
#
# The ternary packings have native kernels for CPU, CUDA, Metal, ROCm, Vulkan
# and SYCL, so this is not the only way to run them - it is the fast way on an
# NVIDIA host. Measured on a laptop i5-12500H with an RTX 3050 (4 GiB), the CPU
# build gives the 4B about 16 tok/s of generation and the 27B about 1.7; a
# small GPU cannot hold the 27B, but it can hold the 4B and most of the 9B.
#
#   podman build -t localhost/niharness-llama-prism-cuda:latest \
#     --build-arg CUDA_ARCHITECTURES=86 \
#     -f containers/Containerfile.llama-server-prism-cuda .
#
# CUDA_ARCHITECTURES is the compute capability of the target GPU (86 for
# Ampere laptop parts, 89 for Ada, 90 for Hopper). Naming one keeps the build
# to minutes instead of an hour; an image meant for several hosts needs the
# list of all of them.
#
# CUDA 12.8 on purpose: the model's KNOWN_ISSUES reports that 13.3 builds
# segfault on load on Linux. The driver is newer than the toolkit, which is
# the supported direction.
#
# At runtime the GPU arrives through CDI, which works rootless:
#
#   nvidia-ctk cdi generate --output ~/.config/cdi/nvidia.yaml
#   podman run --rm --network=host --device nvidia.com/gpu=all \
#     --volume /srv/models:/models:ro \
#     localhost/niharness-llama-prism-cuda:latest \
#     -m /models/Ternary-Bonsai-2-4B-PQ2_0.gguf -ngl 99 -c 32768 --jinja

FROM docker.io/nvidia/cuda:12.8.1-devel-ubuntu24.04 AS build

ARG PRISM_REF=prism-b10787-73bfe6c
ARG CUDA_ARCHITECTURES=86

RUN apt-get update && apt-get install --no-install-recommends -y \
      build-essential cmake git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# libcuda.so.1 belongs to the host driver, not to the toolkit, so it is absent
# at build time and the link fails with a page of undefined `cu*` symbols. The
# toolkit ships a stub to link against; the real library arrives at runtime
# through CDI.
ENV LIBRARY_PATH=/usr/local/cuda/lib64/stubs
RUN ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1

RUN git clone --depth 1 --branch "${PRISM_REF}" \
      https://github.com/PrismML-Eng/llama.cpp /src
RUN cmake -S /src -B /build \
      -DCMAKE_BUILD_TYPE=Release \
      -DLLAMA_CURL=OFF \
      -DGGML_NATIVE=OFF \
      -DGGML_CUDA=ON \
      -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
    && cmake --build /build --target llama-server llama-bench -j

FROM docker.io/nvidia/cuda:12.8.1-runtime-ubuntu24.04
# The CUDA runtime image already ships a user with UID 1000, so creating one
# fails; what matters is not running as root, and a numeric USER says that
# without caring what the account is called.
RUN apt-get update && apt-get install --no-install-recommends -y libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && (id -u 1000 >/dev/null 2>&1 \
        || useradd --create-home --uid 1000 --shell /usr/sbin/nologin llama)
COPY --from=build /build/bin/ /usr/local/lib/llama/
RUN ln -s /usr/local/lib/llama/llama-server /usr/local/bin/llama-server \
    && ln -s /usr/local/lib/llama/llama-bench /usr/local/bin/llama-bench
ENV LD_LIBRARY_PATH=/usr/local/lib/llama

USER 1000
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/llama-server", "--host", "127.0.0.1", "--port", "8080"]
