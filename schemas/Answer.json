{
  "additionalProperties": false,
  "description": "The human answer to one question, appended to the run as an event.",
  "properties": {
    "free_text": {
      "default": "",
      "title": "Free Text",
      "type": "string"
    },
    "option_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Option Id"
    },
    "question_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Question Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "question_id"
  ],
  "title": "Answer",
  "type": "object"
}
