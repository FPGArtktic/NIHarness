          "title": "Done",
          "type": "boolean"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "statement": {
